table TDU
	lineageTag: 8dedd150-5a22-4d59-aa75-81708e06195b

	measure TDU_Varaiance_CCC = [Total_TDU_Variance]
		lineageTag: da5bfa29-188c-4555-90b4-f8cc7ac0e7a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

