	column TDUVariance
		dataType: double
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		sourceProviderType: decimal(38, 2)
		lineageTag: c551080c-df08-42b6-a4b8-3cab36f638b9
		summarizeBy: sum
		sourceColumn: TDUVariance

		annotation SummarizationSetBy = Automatic

	partition TDU = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("(localdb)\MSSQLLocalDB", "UtilityCompany", [Query="SELECT C.CustomerID#(lf)#(tab)  ,CONCAT(C.FirstName,' ',C.LastName) AS FullName#(lf)--    ,C.EmailID#(lf)      ,C.PhoneNumber#(lf)      ,SUM(CASE WHEN F.TransactionTypeID = 1 THEN F.TDUAmount ELSE 0 END) AS TotalTDUCharged#(lf)      ,SUM(CASE WHEN F.TransactionTypeID = 2 THEN F.TDUAmount ELSE 0 END) AS TotalTDUPaid#(lf)#(tab)  ,SUM(CASE WHEN F.TransactionTypeID = 3 THEN F.TDUAmount ELSE 0 END) AS TotalTDURefunded#(lf)      ,SUM(CASE WHEN F.TransactionTypeID = 1 THEN F.TDUAmount ELSE 0 END)#(lf)    -  SUM(CASE WHEN F.TransactionTypeID = 2 THEN F.TDUAmount ELSE 0 END) #(lf)#(tab)-  SUM(CASE WHEN F.TransactionTypeID = 3 THEN F.TDUAmount ELSE 0 END) AS TDUVariance#(lf)FROM FactUsage F#(lf)JOIN DimAccount A ON F.AccountID = A.AccountID#(lf)JOIN DimCustomer C ON A.CustomerID = C.CustomerID#(lf)WHERE C.[CCC] = 'Y'  #(lf)GROUP BY #(lf)    C.CustomerID,#(lf)    C.FirstName,#(lf)    C.LastName,#(lf)--#(tab)C.EmailID,#(lf)    C.PhoneNumber#(lf)HAVING       #(lf)#(tab)   SUM(CASE WHEN F.TransactionTypeID = 1 THEN F.TDUAmount ELSE 0 END)#(lf)    -  SUM(CASE WHEN F.TransactionTypeID = 2 THEN F.TDUAmount ELSE 0 END) #(lf)#(tab)-  SUM(CASE WHEN F.TransactionTypeID = 3 THEN F.TDUAmount ELSE 0 END) > 0", CommandTimeout=#duration(69, 10, 40, 0)])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

