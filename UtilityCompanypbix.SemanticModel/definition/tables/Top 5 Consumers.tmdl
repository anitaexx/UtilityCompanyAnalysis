table 'Top 5 Consumers'
	lineageTag: e03e1c1b-0755-4782-8924-94592480738a

	column CustomerID
		dataType: int64
		isNullable: false
		formatString: 0
		sourceProviderType: int
		lineageTag: 91adfa40-9cd6-41ea-af19-2282456a2e50
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column FullName
		dataType: string
		isNullable: false
		sourceProviderType: nvarchar(101)
		lineageTag: b4dd5363-c84c-4188-be2d-618c8278e5a8
		summarizeBy: none
		sourceColumn: FullName

		annotation SummarizationSetBy = Automatic

	column CompanyName
		dataType: string
		sourceProviderType: nvarchar(50)
		lineageTag: d260abe8-1ef0-4077-a3fa-0a510640a69f
		summarizeBy: none
		sourceColumn: CompanyName

