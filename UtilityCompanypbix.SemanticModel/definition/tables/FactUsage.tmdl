table FactUsage
	lineageTag: b1642088-32b6-4d7c-86f3-10840b89942c

	measure TotalPayments =
			
			CALCULATE(
			    SUM(FactUsage[FullAmount]),
			    FILTER(
			        FactUsage,
			        FactUsage[TransactionTypeID] = 2
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c2f9ec6d-f37e-462e-bc18-ce1786083a0d

	measure TotalRefunds =
			
			CALCULATE(
			    SUM(FactUsage[FullAmount]),
			    FILTER(
			        FactUsage,
			        FactUsage[TransactionTypeID] = 3
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f9262f9a-5e22-4a6d-9bae-e17d3ddfe6f0

	measure RefundPercent = ```
			DIVIDE([TotalRefunds], [TotalPayments], 0)
			
			```
		lineageTag: 427f679f-d2da-4de9-8980-88ee76144cb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_TDU_Billed = CALCULATE(Sum(FactUsage[TDUAmount]),FactUsage[TransactionTypeID] = 1)
		lineageTag: 426bef90-d485-4acf-bb6b-2191ea1d4aad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_TDU_Paid_Refunded = CALCULATE(SUM(FactUsage[TDUAmount]),FILTER(FactUsage, FactUsage[TransactionTypeID] = 2 || FactUsage[TransactionTypeID] = 3))
		lineageTag: 40c2c85e-f68c-477b-b8da-6b13f4aacbee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_TDU_Variance =
			VAR diff = [Total_TDU_Billed] - [Total_TDU_Paid_Refunded]
			                     RETURN  if(diff > 0, diff)
		lineageTag: e911baa7-5965-41f0-8a50-40df9550aca3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CCCtoTotalTDU_Variance = DIVIDE([CCC_TDU_Variance],[Total_TDU_Variance],0)
		lineageTag: ca93f16f-b3fd-45e7-af8f-2539457d20d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CCC_TDU_Billed = ```
			CALCULATE(Sum(FactUsage[TDUAmount]),FILTER(DimCustomer, DimCustomer[CCC] = "Y"),FactUsage[TransactionTypeID] = 1)
			
			```
		lineageTag: 7a18c3a5-e6de-45a3-831f-0cf4c3a71415

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CCC_TDU_Paid_Refunded = ```
			CALCULATE(SUM(FactUsage[TDUAmount]),FILTER(DimCustomer, DimCustomer[CCC] = "Y"),FILTER(FactUsage, FactUsage[TransactionTypeID] = 2 || FactUsage[TransactionTypeID] = 3))
			
			```
		lineageTag: 9fa37dc1-a9da-45c8-a163-48206b36953b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CCC_TDU_Variance =
			VAR diff = [CCC_TDU_Billed] - [CCC_TDU_Paid_Refunded]
			                     RETURN  if(diff > 0, diff)
		lineageTag: 3b674af3-c8e8-47be-a82d-09e0150718f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

