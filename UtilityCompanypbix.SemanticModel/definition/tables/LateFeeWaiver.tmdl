	partition LateFeeWaiver = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("(localdb)\MSSQLLocalDB", "UtilityCompany", [Query=" SELECT  C.[CustomerID]#(lf)#(tab)#(tab),CONCAT(C.FirstName,' ',C.LastName) AS FullName#(lf)#(tab)#(tab),C.[CustomerType] #(lf)#(tab)#(tab),CASE WHEN C.[CompanyName] = '' THEN 'RESIDENT' ELSE C.[CompanyName] END AS CompanyName#(lf)#(tab)#(tab),C.[PhoneNumber]#(lf)#(tab)#(tab),C.[EmailID]#(tab)#(tab)#(lf)#(tab)#(tab),C.[CCC]#(lf)#(tab)#(tab),SUM(CASE WHEN F.[TransactionTypeID] = 4 THEN F.TransactionAmount + F.TDUAmount ELSE 0 END) AS TotalLateFees#(lf)FROM FactUsage F#(lf)JOIN DimCustomer C ON F.[CustomerID] = C.[CustomerID]#(lf)WHERE C.[CCC] = 'Y'#(lf)GROUP BY C.[CustomerID]#(lf)#(tab)#(tab),C.[FirstName]#(lf)#(tab)#(tab),C.[LastName]#(lf)#(tab)#(tab),C.[CustomerType] #(lf)#(tab)#(tab),C.[CompanyName]#(lf)#(tab)#(tab),C.[PhoneNumber]#(lf)#(tab)#(tab),C.[EmailID]#(tab)#(tab)#(lf)#(tab)#(tab),C.[CCC]#(lf)HAVING SUM(CASE WHEN F.[TransactionTypeID] = 4 THEN F.TransactionAmount + F.TDUAmount ELSE 0 END) > 0", CommandTimeout=#duration(69, 10, 40, 0)])
				in
				    Source

	changedProperty = Name

